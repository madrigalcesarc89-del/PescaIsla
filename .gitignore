# Godot 4 .gitignore — PescaIsla
.godot/
android/build/
android/.gradle/

# Exportados Android
*.apk
*.aab
*.keystore

# Backups editor
*.tmp
*.bak
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python temporal
__pycache__/
*.pyc

# Local: ruta del Godot de este PC (no commitear)
docs/godot-path.txt

# Reorg: originales y trabajo sin clasificar (no commitear, ver AGENTS.md)
source/
# Previews locales de validación (reorg_base.png ya commiteado se conserva)
docs/previews/
# Ajustes locales de exportación (cada PC los suyos; ver AGENTS.md)
export_presets.cfg
# Claves y certificados extra
*.jks
*.p12
*.pfx
*.key
*.pem
